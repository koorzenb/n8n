# Reference settings for the lunch calendar workflow.
# n8n does not automatically use these values as node credentials. Create the
# Gmail and Google Calendar OAuth credentials in the n8n UI after importing.

# Google Cloud OAuth 2.0 Web application credentials for the custom OAuth app
# used by this self-hosted n8n instance. Use these in n8n's credential forms.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Account identities used when authorizing the credentials in n8n.
# Gmail is the account that receives the vendor's messages.
GMAIL_GOOGLE_ACCOUNT=
# Prefer the account that owns KoorzenFamily for the Calendar credential.
GOOGLE_CALENDAR_ACCOUNT=

# Workflow configuration
GMAIL_VENDOR_SENDER=info@nslunch.ca
GMAIL_VENDOR_SUBJECT=School lunches: Order Confirmation
GOOGLE_CALENDAR_ID=koorzenfamilie@gmail.com
